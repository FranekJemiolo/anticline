{
  "name": "@franekjemiolo/anticline",
  "version": "1.0.0",
  "description": "Offline-first visual quant terminal and visual workbench for Orogen lakehouse",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "tsc --noEmit",
    "lighthouse": "lhci autorun"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FranekJemiolo/anticline.git"
  },
  "keywords": [
